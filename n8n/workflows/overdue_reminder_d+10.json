{
  "name": "ClearFlow - Overdue Reminder (D+10)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 9 * * *" }]
        }
      },
      "name": "Daily 9AM Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.BACKEND_URL}}/api/chittis",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Cookie", "value": "={{$env.SERVICE_SESSION_COOKIE}}" }]
        }
      },
      "name": "Fetch All Chittis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "jsCode": "// Filters chittis whose cycle anchor day was exactly 10 days ago.\nconst today = new Date();\nconst targetDay = new Date(today);\ntargetDay.setDate(today.getDate() - 10);\nconst dayNum = targetDay.getDate();\n\nconst anchorMap = { '1st':1, '5th':5, '10th':10, '15th':15, '20th':20, '25th':25 };\n\nreturn $input.all().filter(item => {\n  const chitti = item.json;\n  return anchorMap[chitti.Cycle_Anchor_Day] === dayNum;\n}).map(item => ({ json: item.json }));"
      },
      "name": "Filter Matching Anchor Day",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_URL}}/api/whatsapp/broadcast",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "chitti_id", "value": "={{$json.Chitti_ID}}" },
            { "name": "target", "value": "all_pending" },
            { "name": "message_type", "value": "overdue" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Cookie", "value": "={{$env.SERVICE_SESSION_COOKIE}}" }]
        }
      },
      "name": "Broadcast Overdue Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 300],
      "notes": "Backend filters to Payment_Status != 'Verified' shares only."
    }
  ],
  "connections": {
    "Daily 9AM Trigger": { "main": [[{ "node": "Fetch All Chittis", "type": "main", "index": 0 }]] },
    "Fetch All Chittis": { "main": [[{ "node": "Filter Matching Anchor Day", "type": "main", "index": 0 }]] },
    "Filter Matching Anchor Day": { "main": [[{ "node": "Broadcast Overdue Reminder", "type": "main", "index": 0 }]] }
  }
}
