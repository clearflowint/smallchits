:80 {
    # Backend API (FastAPI)
    handle /api/* {
        reverse_proxy fastapi-backend:8000
    }

    # n8n Automation Engine
    handle /n8n/* {
        reverse_proxy n8n:5678
    }

    # Vue.js PWA Frontend (catch-all)
    handle {
        reverse_proxy vue-frontend:80
    }

    encode gzip
}
